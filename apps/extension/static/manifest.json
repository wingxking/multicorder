{
  "manifest_version": 3,
  "name": "Multicorder",
  "version": "0.1.0",
  "description": "Record several browser tabs at once, each with its own live captions and summary, on your Mac.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Record this tab", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["tabCapture", "offscreen", "sidePanel", "storage", "unlimitedStorage", "nativeMessaging", "activeTab", "scripting", "contextMenus", "tabs"],
  "commands": {
    "toggle-capture": { "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" }, "description": "Start recording this tab" }
  }
}
