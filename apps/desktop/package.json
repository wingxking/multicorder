{
  "name": "@multicorder/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepare-host": "node scripts/prepare-host.mjs",
    "tauri": "tauri",
    "app:debug": "node scripts/prepare-host.mjs debug && tauri build --debug --bundles app",
    "app:release": "node scripts/prepare-host.mjs release && tauri build --bundles app"
  },
  "dependencies": {
    "@multicorder/ui": "workspace:*",
    "@tauri-apps/api": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "wavesurfer.js": "7.12.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
