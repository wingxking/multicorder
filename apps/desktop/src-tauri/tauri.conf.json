{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multicorder",
  "version": "0.1.1",
  "identifier": "com.multicorder.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Multicorder", "width": 1080, "height": 760, "minWidth": 720, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; img-src 'self' blob: data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/multicorder-host"],
    "resources": { "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "macOS": { "minimumSystemVersion": "14.4" }
  }
}
